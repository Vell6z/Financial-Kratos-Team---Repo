# ---------------------------------------------
# .gitignore general — Financial Kratos Team
# ---------------------------------------------

# === Variables de entorno y secretos ===
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
# Carpeta de secretos completa (llaves de Open Payments, etc.)
secrets/


# === Dependencias ===
node_modules/
bower_components/
jspm_packages/
vendor/

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Builds / salidas ===
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
coverage/
*.tsbuildinfo

# === Node / JS / package managers ===
.npm
.yarn/
.pnp.*
.eslintcache

# === Python ===
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Java / JVM ===
*.class
target/
*.jar
*.war
*.ear
.gradle/

# === Bases de datos locales ===
*.sqlite
*.sqlite3
*.db

# === Editores / IDEs ===
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# === Sistema operativo ===
.DS_Store
Thumbs.db
desktop.ini
*~

# === Next.js / demo ===
.vercel
next-env.d.ts
# Base de datos local de la demo (solo la carpeta de la raíz, no cualquier "data")
/data/

# === Claude Code: configuración personal de cada quien (launch.json sí se comparte) ===
.claude/settings.local.json

certificates