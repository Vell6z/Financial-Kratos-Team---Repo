# Open Payments (Interledger) — sin estas variables la app corre en modo simulado.
# Wallet de la plataforma en https://wallet.interledger-test.dev (Settings → Developer Keys): firma las peticiones
OP_PLATFORM_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-plataforma
OP_KEY_ID=
# Ruta al private.key descargado (no lo subas al repo; *.key ya está en .gitignore)
OP_PRIVATE_KEY_PATH=./secrets/private.key
# Bóveda: wallet que recibe las inversiones (si se omite, se usa la de la plataforma)
OP_VAULT_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-boveda
# Tope total del permiso de retiros automáticos. En dólares (se convierte a la moneda de la bóveda con la tasa del día)
# o directamente en la moneda de la bóveda. Por defecto 1000 en la moneda de la bóveda.
# OP_VAULT_GRANT_LIMIT_USD=100000
# OP_VAULT_GRANT_LIMIT=1000
# Wallet real de la cuenta demo de inversionista (para invertir de verdad con ella)
OP_DEMO_INVESTOR_WALLET=
# Pesos → moneda de la bóveda: por defecto tasa de mercado (open.er-api.com). Descomenta para fijarla a mano (ej. sin internet en la demo).
# OP_COP_PER_UNIT=4000

# Bre-B (Wompi): verificación de llaves antes de desembolsar. Solo lectura (GET /breb/keys/resolve).
# sandbox (por defecto) o production. Sin credenciales se simula con las llaves de prueba del sandbox.
WOMPI_ENV=sandbox
# Solo para verificar llaves: production consulta el directorio real con WOMPI_PROD_* (solo lectura). Los payouts siguen en sandbox.
# WOMPI_RESOLVE_ENV=production
WOMPI_SANDBOX_API_URL=https://api.sandbox.payouts.wompi.co/v2
WOMPI_SANDBOX_API_KEY=
WOMPI_SANDBOX_USER_PRINCIPAL_ID=
# Producción: solo para verificar llaves reales. Nunca se usan para crear payouts.
WOMPI_PROD_API_URL=https://api.payouts.wompi.co/v2
WOMPI_PROD_API_KEY=
WOMPI_PROD_USER_PRINCIPAL_ID=
